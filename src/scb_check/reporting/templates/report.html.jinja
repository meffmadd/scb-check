<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>
    :root { color-scheme: light; font: 15px/1.5 system-ui, sans-serif; color: #18212b; background: #f5f7fa; }
    body { margin: 0 auto; max-width: 90rem; padding: 2rem 1rem; }
    header { margin-bottom: 2rem; }
    h1 { margin: 0; font-size: 2rem; letter-spacing: -.04em; }
    header p { margin: .5rem 0 1.25rem; color: #536273; }
    details { margin: .75rem 0; }
    summary { cursor: pointer; color: #46566a; }
    li { padding: .25rem 0; }
    code, h2, h3 { overflow-wrap: anywhere; }
    .metric-group { margin: 1.5rem 0; border-top: 1px solid #d8e0e9; }
    .metric-group > summary { padding: 1rem 0; }
    .metric-group > summary h2 { display: inline; font-size: 1.2rem; color: #18212b; }
    .group-count { margin-left: .75rem; font-size: .85rem; color: #536273; }
    section { margin: 1rem 0 2rem; }
    section > h3 { margin-bottom: .75rem; font: 600 1rem/1.5 ui-monospace, monospace; }
    .plot-card { min-width: 0; padding: 1rem .25rem .25rem; background: #fff; border: 1px solid #e0e5ec; border-radius: .75rem; }
    h4 { margin: 0 1rem; font-size: .9rem; font-weight: 500; color: #536273; }
    .metric-plot { width: 100%; min-width: 0; height: 400px; }
    .plot-note { margin: 0 1rem 1rem; color: #536273; }
    noscript { display: block; padding: 1rem; background: #fff0cf; }
    pre { white-space: pre-wrap; }
  </style>
</head>
<body>
  <header>
    <h1>{{ title }}</h1>
    <p>{{ payload.labels | length }} steps · {{ payload.runs | length }} series · {{ metric_count }} metrics</p>
    <details id="source-directories">
      <summary>Source directories</summary>
      {% for run in payload.runs %}
      {% if run.name %}<h3>{{ run.name }}</h3>{% endif %}
      <ol>{% for path in run.paths %}<li><code>{{ path if path is not none else 'Missing snapshot' }}</code></li>{% endfor %}</ol>
      {% endfor %}
    </details>
    <details>
      <summary>About this report</summary>
      <p>Inputs are evenly spaced in supplied order, not elapsed time. Missing measurements are unavailable,
        not zero, and interrupt lines. Fractions display as percentages.</p>
      <p>Each plot shows Kendall τ-b against step order. Missing observations are omitted; constant series and series with fewer than two observations have unavailable τ. The signed mean and median weight the available coefficients equally. The flat-adjusted mean also counts constant series with at least two observations as zero; shorter series remain excluded. These summaries are descriptive, not significance tests.</p>
      <p>Trends are not churn or quality judgments. Population and coverage changes can affect values.</p>
    </details>
  </header>
  <noscript>Enable JavaScript to view the charts and hover measurements.</noscript>
  {% for group in groups %}
  <details id="metric-group-{{ group.name }}" class="metric-group">
    <summary><h2>{{ group.name }}<span class="group-count">{{ group.sections | length }} metrics</span></h2></summary>
    {% for section in group.sections %}
    <section>
    <h3>{{ section.metric }}</h3>
    <div class="plot-card">
      <h4 id="{{ section.plot_id }}-heading">Values ({{ section.unit }}) · {{ section.summary }}</h4>
      <div id="{{ section.plot_id }}" class="metric-plot" role="img" aria-labelledby="{{ section.plot_id }}-heading"></div>
      {% if section.all_unavailable %}<p class="plot-note">All measurements unavailable.</p>{% endif %}
    </div>
    </section>
    {% endfor %}
  </details>
  {% endfor %}
  <details><summary>Plotly.js license</summary><pre>{{ plotly_license }}</pre></details>
  <script id="report-data" type="application/json">{{ payload | tojson }}</script>
  <script>{{ plotly_js }}</script>
  <script>{{ report_js }}</script>
</body>
</html>
